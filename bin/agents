#!/usr/bin/env bash
# bin/agents — unified entrypoint for dr-agents tooling
#
# Usage:
#   agents install --global
#   agents install --repo [--profile <name>]
#   agents status
#   agents update --global
#   agents update --repo [--profile <name>]
#   agents update --all

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat >&2 <<EOF
Usage: agents <command> [options]

Commands:
  install                         Check workflow presence/drift in .github/workflows/
  install --global                Install claudio-dr and cody-dr globally
  install --repo [--profile N]    Install claudio-dr into the current repo
  install --workflows [--force]   Install managed workflows to .github/workflows/
  status                          Show installed versions and locations
  update --global [--force]       Pull catalog and update global install
  update --global --workflows     Pull catalog and update managed workflows in CWD
  update --repo [--profile N]     Pull catalog and update repo-local install
  update --all [--force]          Pull catalog and update both installs
  (use --force to resolve conflicts: agents update --global --force)
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage
fi

command="$1"; shift

case "$command" in
  install)  exec bash "${REPO_DIR}/bin/install" "$@" ;;
  update)   exec bash "${REPO_DIR}/bin/update"  "$@" ;;
  status)   exec bash "${REPO_DIR}/bin/install" --status "$@" ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: ${command}" >&2; usage ;;
esac
