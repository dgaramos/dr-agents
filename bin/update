#!/usr/bin/env bash
# bin/update — pull the latest catalog and re-run bin/install for every active install
#
# Modes:
#   --global              git pull, then re-run bin/install --global
#   --repo [--profile N]  git pull, then re-run bin/install --repo [--profile N]
#   --all                 git pull, then re-run both --global and --repo (if .claude/ exists)
#
# Use --force to skip conflict checking during the install step. This is the
# canonical way to resolve conflicts:
#   agents update --global --force

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat >&2 <<EOF
Usage: bin/update --global [--force]
       bin/update --global --workflows [--force]
       bin/update --repo [--profile <name>] [--force]
       bin/update --all [--force]
       bin/update --download

  --global             Pull the catalog and update the global install (~/.claude/ and Codex config).
  --global --workflows Pull the catalog and update managed workflow stubs in .github/workflows/ of the
                       current repo. Workflows whose embedded version does not match the catalog
                       version are updated and reported as 'updated'. Current workflows are reported
                       as 'unchanged'. Use --force to overwrite all regardless of version.
  --repo               Pull the catalog and update the repo-local install (.claude/ in CWD).
                       Combine with --profile <name> to re-apply a named profile.
  --all                Pull the catalog and update both global and repo-local installs.
                       --repo is skipped when .claude/ does not exist in the current directory.
  --download           Update a download-based install. Reads the current version from the
                       catalog-path pointer file, queries GitHub releases for the latest tag,
                       downloads and installs when a newer version is available, and prints
                       "Already at vX.Y.Z" when already up to date. Previous version directories
                       are preserved for manual rollback.
  --force              Forward --force to bin/install, skipping conflict checking and
                       overwriting all files from the catalog source. Use this as the
                       canonical resolution path for conflicts: agents update --global --force
EOF
  exit 1
}

pull_catalog() {
  echo "Pulling latest catalog from origin..."
  git -C "${REPO_DIR}" pull --ff-only
  echo ""
}

# ---------------------------------------------------------------------------
# update_downloaded — update a download-based install to the latest release
# ---------------------------------------------------------------------------

update_downloaded() {
  local catalog_store="${HOME}/.local/share/dr-agents"
  local pointer_file="${catalog_store}/catalog-path"
  local repo_slug="dgaramos/dr-agents"
  local api_base="https://api.github.com/repos/${repo_slug}"

  # Read current installed path from pointer file
  if [[ ! -f "${pointer_file}" ]]; then
    echo "ERROR: no pointer file found at ${pointer_file}" >&2
    echo "Run 'bin/install --download' to perform an initial download-based install." >&2
    exit 1
  fi

  local current_path
  current_path="$(< "${pointer_file}")"
  # Derive the version tag from the last component of the install path
  local current_ver
  current_ver="$(basename "${current_path}")"

  echo "Current installed version: ${current_ver}"
  echo "Resolving latest release from GitHub..."

  local api_response
  api_response="$(curl -fsSL "${api_base}/releases/latest")"
  local latest_ver
  latest_ver="$(echo "${api_response}" | grep '"tag_name"' | head -1 | sed 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"

  if [[ -z "${latest_ver}" ]]; then
    echo "ERROR: could not resolve latest release version from GitHub" >&2
    exit 1
  fi

  echo "Latest available version: ${latest_ver}"

  if [[ "${current_ver}" == "${latest_ver}" ]]; then
    echo "Already at ${current_ver}"
    exit 0
  fi

  echo "Updating from ${current_ver} to ${latest_ver}..."
  bash "${REPO_DIR}/bin/install" --download --version "${latest_ver}"
}

if [[ $# -eq 0 ]]; then
  usage
fi

MODE=""
PROFILE_NAME=""
FORCE_FLAG=""
WORKFLOWS=0

# --global, --repo, --all and --download are the four alternative invocations
# in usage(); no two may be combined. Selecting the mode through this helper
# rejects a conflicting pair during parsing, which makes the rejection
# order-independent and — because it happens before pull_catalog — independent
# of whether the checkout's branch has a configured upstream. Repeating the
# same flag is idempotent, not a conflict.
set_mode() {
  local requested="$1"
  if [[ -n "${MODE}" && "${MODE}" != "${requested}" ]]; then
    echo "--${MODE} and --${requested} are mutually exclusive" >&2
    exit 1
  fi
  MODE="${requested}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --global)    set_mode "global";   shift ;;
    --repo)      set_mode "repo";     shift ;;
    --all)       set_mode "all";      shift ;;
    --download)  set_mode "download"; shift ;;
    --workflows) WORKFLOWS=1;      shift ;;
    --force)     FORCE_FLAG="--force"; shift ;;
    --profile)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "--profile requires a name argument" >&2
        exit 1
      fi
      PROFILE_NAME="$2"
      shift 2
      ;;
    -h|--help) usage ;;
    *) echo "Unknown argument: $1" >&2; usage ;;
  esac
done

[[ -n "${MODE}" ]] || usage

if [[ "${PROFILE_NAME}" != "" && "${MODE}" == "global" ]]; then
  echo "--profile is not valid with --global" >&2
  exit 1
fi

if [[ "${WORKFLOWS}" == "1" && "${MODE}" != "global" ]]; then
  echo "--workflows is only valid with --global" >&2
  exit 1
fi

if [[ "${MODE}" == "download" && -n "${FORCE_FLAG}" ]]; then
  echo "--force is not valid with --download" >&2
  exit 1
fi

# --download combined with --workflows is already rejected above by the
# "--workflows is only valid with --global" guard, which fires for every mode
# other than global. A second, narrower guard for that same pair was
# unreachable and is not reinstated: enumerating rejected combinations one pair
# at a time is what let the mode-versus-mode conflict go unnoticed.

if [[ "${MODE}" == "download" ]]; then
  update_downloaded
  exit $?
fi

pull_catalog

if [[ "${WORKFLOWS}" == "1" ]]; then
  # Update managed workflows in the current repo from the catalog.
  bash "${REPO_DIR}/bin/install" --workflows ${FORCE_FLAG}
  exit $?
fi

case "${MODE}" in
  global)
    bash "${REPO_DIR}/bin/install" --global ${FORCE_FLAG}
    ;;
  repo)
    if [[ -n "${PROFILE_NAME}" ]]; then
      bash "${REPO_DIR}/bin/install" --repo --profile "${PROFILE_NAME}" ${FORCE_FLAG}
    else
      bash "${REPO_DIR}/bin/install" --repo ${FORCE_FLAG}
    fi
    ;;
  all)
    bash "${REPO_DIR}/bin/install" --global ${FORCE_FLAG}
    echo ""
    if [[ -d ".claude" ]]; then
      if [[ -n "${PROFILE_NAME}" ]]; then
        bash "${REPO_DIR}/bin/install" --repo --profile "${PROFILE_NAME}" ${FORCE_FLAG}
      else
        bash "${REPO_DIR}/bin/install" --repo ${FORCE_FLAG}
      fi
    else
      echo "No .claude/ found in $(pwd) — skipping repo update."
    fi
    ;;
esac
