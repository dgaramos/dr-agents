#!/usr/bin/env bash
# bin/install — install dr-agents skills and plugins globally or per-repo
#
# Modes:
#   (no args)             check workflow presence and drift in CWD .github/workflows/
#   --global              register claudio-dr and cody-dr through their marketplaces
#   --repo [--profile N]  install to .claude/ in CWD; optionally apply named profile overrides
#   --status              report what is currently installed globally and per-repo in CWD
#   --workflows           install managed workflow stubs to CWD .github/workflows/
#
# On conflict between an existing file and the source, the script prints a
# warning naming both versions and exits non-zero without overwriting.
# Re-running after a clean state is safe; existing symlinks are replaced.
#
# Use --force to skip conflict checking and overwrite all files from the
# catalog source. A warning is printed for every overwritten file showing
# both versions. This is the canonical way to resolve conflicts; use:
#   agents update --global --force

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat >&2 <<EOF
Usage: bin/install [--force]
       bin/install --global [--force]
       bin/install --repo [--profile <name>] [--force]
       bin/install --download [--version <tag>]
       bin/install --status
       bin/install --workflows [--force]

  (no mode)         Check workflow presence and drift in .github/workflows/ of
                    the current repo. Reports each managed workflow as 'present',
                    'absent', 'drifted', or 'MISMATCH' — the last meaning the
                    stub carries the current version marker over different
                    content, which exits non-zero. Also reports any catalog
                    core/ file vendored at the repository root, by name and
                    state ('identical'/'diverged'), and exits non-zero: nothing
                    installs or runs such copies. No files are written.
  --global          Install claudio-dr from this catalog's dr-agents Claude Code
                    marketplace and cody-dr from its dr-agents Codex
                    marketplace. No plugin tree is copied into ~/.claude/ or
                    ~/.codex/ directly.
  --repo            Install claudio-dr plugin to .clone/ in the current repo.
                    Combine with --profile <name> to apply profile-specific
                    overrides from profiles/<name>.md.
  --download        Download the catalog from GitHub releases and install globally.
                    Resolves the latest release unless --version <tag> is given.
                    Extracts to ~/.local/share/dr-agents/<version>/ and
                    writes a catalog-path pointer file. Skips download when the
                    version is already extracted. Previous version directories
                    are preserved for manual rollback.
  --version <tag>   Pin the download to a specific release tag (e.g. v1.2.3).
                    Only valid with --download.
  --status          Show what is currently installed globally and in the current
                    repo's .claude/ directory.
  --workflows       Install managed workflow stubs from the catalog into
                    .github/workflows/ of the current repo. Skips workflows already
                    at the current version and byte-identical to the template.
                    Reports each action as 'installed', 'updated', 'unchanged', or
                    'MISMATCH'. A MISMATCH is left untouched and exits non-zero;
                    use --force to overwrite it. Publishers are thin dispatch
                    stubs: no publication script is copied into the repository.
                    Vendored catalog core/ files are reported the same way as
                    in the no-mode check and also exit non-zero.
  --force           Skip conflict checking and overwrite all files from the
                    catalog source, printing a warning for each overwritten
                    file. Use 'agents update --global --force' to resolve
                    conflicts during an update without manual cp commands.
EOF
  exit 1
}

# ---------------------------------------------------------------------------
# Version helpers
# ---------------------------------------------------------------------------

claudio_version() {
  local manifest="${REPO_DIR}/plugins/claudio-dr/.claude-plugin/plugin.json"
  if command -v jq >/dev/null 2>&1; then
    jq -r '.version' "${manifest}"
  else
    grep '"version"' "${manifest}" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
  fi
}

cody_version() {
  local manifest="${REPO_DIR}/plugins/cody-dr/.codex-plugin/plugin.json"
  if command -v jq >/dev/null 2>&1; then
    jq -r '.version' "${manifest}"
  else
    grep '"version"' "${manifest}" | head -1 | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
  fi
}

# Return the version string embedded in an already-installed plugin.json, or
# "unknown" when the file is absent or unparseable.
installed_version() {
  local manifest="$1"
  if [[ ! -f "${manifest}" ]]; then
    echo "not installed"
    return
  fi
  if command -v jq >/dev/null 2>&1; then
    jq -r '.version // "unknown"' "${manifest}" 2>/dev/null || echo "unknown"
  else
    grep '"version"' "${manifest}" | head -1 \
      | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' \
      || echo "unknown"
  fi
}

# ---------------------------------------------------------------------------
# Copy helper — copy a single file, refusing to overwrite a non-symlink target
# whose content differs from the source (unless FORCE=1).
# ---------------------------------------------------------------------------

install_file() {
  local src="$1"
  local dest="$2"
  local label="$3"
  local src_ver="$4"
  # FORCE is a global set by mode_global / mode_repo from the --force flag.

  local dest_dir
  dest_dir="$(dirname "${dest}")"
  mkdir -p "${dest_dir}"

  if [[ -L "${dest}" ]]; then
    # Replace existing symlink without complaint.
    rm "${dest}"
  elif [[ -e "${dest}" ]]; then
    if cmp -s "${src}" "${dest}"; then
      if [[ "${FORCE:-0}" == "1" ]]; then
        # Force but identical — skip silently, nothing to overwrite.
        echo "  unchanged  ${label}  (force, already current)"
      else
        echo "  unchanged  ${label}"
      fi
      return 0
    fi
    local dest_ver
    dest_ver="$(installed_version "$(dirname "${dest}")/plugin.json" 2>/dev/null || echo "unknown")"
    if [[ "${FORCE:-0}" == "1" ]]; then
      # Force mode: content differs, overwrite and warn.
      echo "  WARNING   overwriting ${label}  (local: v${dest_ver} → catalog: v${src_ver})"
    else
      # Real file exists and differs — conflict without --force.
      echo "  CONFLICT  ${label}" >&2
      echo "    source  : ${src}  (v${src_ver})" >&2
      echo "    existing: ${dest}  (v${dest_ver})" >&2
      return 1
    fi
  fi

  cp "${src}" "${dest}"
  echo "  installed  ${label}  (v${src_ver})"
}

# Write the catalog path to the standard pointer file so bin/drift can locate
# the catalog without AGENT_WORKFLOWS_DIR being set.
write_pointer_file() {
  local catalog_path="$1"
  local pointer_dir="${HOME}/.local/share/dr-agents"
  mkdir -p "${pointer_dir}"
  echo "${catalog_path}" > "${pointer_dir}/catalog-path"
}

# Generate the agents CLI wrapper that reads the pointer file at runtime.
# This makes the wrapper work for both clone-based and download-based installs;
# the pointer file always points to the active catalog path.
write_agents_wrapper() {
  local pointer_file="$1"
  local dest="$2"
  mkdir -p "$(dirname "${dest}")"
  cat > "${dest}" <<EOF
#!/usr/bin/env bash
# agents — reads the catalog path from the pointer file at runtime so the
# wrapper works for both clone-based (bin/install --global) and download-based
# (bin/install --download) installs without needing to be reinstalled on update.
_catalog="\$(cat "${pointer_file}" 2>/dev/null || true)"
if [[ -z "\$_catalog" ]]; then
  echo "agents: catalog not found; run agents install --global or bin/install --download" >&2
  exit 1
fi
exec bash "\${_catalog}/bin/agents" "\$@"
EOF
  chmod +x "${dest}"
}

# ---------------------------------------------------------------------------
# Checksum helper — verify a downloaded file against its .sha256 sidecar.
# Supports both sha256sum (Linux) and shasum -a 256 (macOS).
# ---------------------------------------------------------------------------
verify_checksum() {
  local sha256_file="$1"
  local check_dir="$2"  # directory in which the checksum paths are relative
  if command -v sha256sum >/dev/null 2>&1; then
    (cd "${check_dir}" && sha256sum --check "${sha256_file##*/}")
  elif command -v shasum >/dev/null 2>&1; then
    (cd "${check_dir}" && shasum -a 256 --check "${sha256_file##*/}")
  else
    echo "ERROR: neither sha256sum nor shasum is available; cannot verify checksum" >&2
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# --download [--version vX.Y.Z]
# ---------------------------------------------------------------------------

mode_download() {
  local version="$1"  # may be empty → resolve latest from GitHub releases API

  local catalog_store="${HOME}/.local/share/dr-agents"
  local tmp_dir="${catalog_store}/tmp"
  local repo_slug="dgaramos/dr-agents"
  local api_base="https://api.github.com/repos/${repo_slug}"
  local release_base="https://github.com/${repo_slug}/releases/download"

  mkdir -p "${tmp_dir}"

  # Resolve version
  if [[ -z "${version}" ]]; then
    echo "Resolving latest release from GitHub..."
    local api_response
    api_response="$(curl -fsSL "${api_base}/releases/latest")"
    version="$(echo "${api_response}" | grep '"tag_name"' | head -1 | sed 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
    if [[ -z "${version}" ]]; then
      echo "ERROR: could not resolve latest release version from GitHub" >&2
      exit 1
    fi
    echo "  latest: ${version}"
  fi

  local extract_dir="${catalog_store}/${version}"

  # Skip download when the version is already extracted
  if [[ -d "${extract_dir}" ]]; then
    echo "Version ${version} already extracted at ${extract_dir}; skipping download."
    write_pointer_file "${extract_dir}"
    _install_from_extracted "${extract_dir}"
    return
  fi

  local tarball_name="dr-agents-${version}.tar.gz"
  local sha256_name="dr-agents-${version}.sha256"

  echo "Downloading ${tarball_name}..."
  curl -fsSL "${release_base}/${version}/${tarball_name}" \
    -o "${tmp_dir}/${tarball_name}"

  echo "Downloading ${sha256_name}..."
  curl -fsSL "${release_base}/${version}/${sha256_name}" \
    -o "${tmp_dir}/${sha256_name}"

  echo "Verifying checksum..."
  verify_checksum "${tmp_dir}/${sha256_name}" "${tmp_dir}"

  echo "Extracting to ${extract_dir}..."
  mkdir -p "${extract_dir}"
  tar -xzf "${tmp_dir}/${tarball_name}" -C "${extract_dir}" --strip-components=1

  write_pointer_file "${extract_dir}"
  _install_from_extracted "${extract_dir}"

  echo ""
  echo "Download install complete: ${extract_dir}"
  echo "To update in the future, run: agents update --download"
}

# Run global install with REPO_DIR pointing to an extracted catalog directory.
_install_from_extracted() {
  local extracted_dir="$1"
  REPO_DIR="${extracted_dir}" \
    HOME="${HOME}" \
    CODEX_CONFIG_DIR="${CODEX_CONFIG_DIR:-${HOME}/.codex}" \
    CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}" \
    bash "${extracted_dir}/bin/install" --global
}

# Copy an entire plugin directory tree, calling install_file for each file.
# Skips the workflows/ subdirectory — those templates are installed separately
# via --workflows and are not part of the global/repo skill install.
# Returns 1 if any conflict was detected.
install_plugin_dir() {
  local src_dir="$1"
  local dest_dir="$2"
  local ver="$3"
  local conflicts=0

  while IFS= read -r -d '' src_file; do
    local rel="${src_file#"${src_dir}/"}"
    # Skip workflow templates — installed via --workflows only
    [[ "$rel" == workflows/* ]] && continue
    local dest_file="${dest_dir}/${rel}"
    install_file "${src_file}" "${dest_file}" "${rel}" "${ver}" || conflicts=$((conflicts + 1))
  done < <(find "${src_dir}" -type f -print0)

  return "${conflicts}"
}

# ---------------------------------------------------------------------------
# Workflow management helpers
# ---------------------------------------------------------------------------

# Managed workflow names and their source plugin.
# Each entry is "filename:plugin" where plugin is claudio-dr or cody-dr.
# Derived from the catalog rather than hand-listed. A hand-written list is a
# second place to remember: dr-agents#269 added a seventh publisher whose stubs
# existed in both plugins and would still never have reached a consumer,
# because nothing here knew they existed and nothing complained.
managed_workflows=()
for _tpl in "$REPO_DIR"/plugins/*/workflows/publish-*.yml; do
  [[ -e "$_tpl" ]] || continue
  _plugin="$(basename "$(dirname "$(dirname "$_tpl")")")"
  managed_workflows+=("$(basename "$_tpl"):${_plugin}")
done
unset _tpl _plugin
readonly managed_workflows
if [[ "${#managed_workflows[@]}" -eq 0 ]]; then
  echo "no publisher templates found under ${REPO_DIR}/plugins/*/workflows/" >&2
  exit 1
fi

# Read the embedded version comment from a workflow file.
# Returns the version string (e.g. "0.1.13") or "unknown" when absent.
workflow_embedded_version() {
  local file="$1"
  local plugin="$2"
  if [[ ! -f "$file" ]]; then
    echo "absent"
    return
  fi
  local ver
  ver="$(grep -m1 "^# ${plugin}: v" "$file" 2>/dev/null \
    | sed "s/^# ${plugin}: v//" || true)"
  if [[ -z "$ver" ]]; then
    echo "unknown"
  else
    echo "$ver"
  fi
}

# Classify one installed stub against its catalog template.
#
# Echoes exactly one of: absent | present | mismatch | drifted.
#
# Until dr-agents#282 this decision read the version marker and nothing else, so
# a template that changed without a version bump was reported as 'unchanged' in
# every consumer while genuinely differing from the stub installed there. The
# whole of the #268 guard sat in the catalog for four commits and reached no
# consumer, and the installer said everything was current the entire time.
#
# 'mismatch' is that case and it is deliberately not 'drifted'. Drift is an
# outdated stub, which is expected and is what an update is for. Equal markers
# over differing content means something upstream is wrong: the template was
# changed without a bump, or the stub was edited in place.
#
# Why a byte comparison here, when bin/check compares the same two kinds of file
# through normalize_publisher: that normalization erases the reusable-workflow
# ref because the catalog's own copy is deliberately pinned at @main while the
# template consumers install is pinned at the protected release tag. That
# licence to differ belongs to the catalog, not to a consumer. A consumer stub
# is installed by copy and must equal its template byte for byte — measured
# across all twelve stubs in every consumer. Normalizing here would let a
# consumer stub wrongly pinned at @main compare as equal, which would recreate
# this very silence somewhere more dangerous than where it started. Do not
# "unify" the two comparisons; they answer different questions.
workflow_stub_state() {
  local dest="$1" src="$2" plugin="$3" catalog_ver="$4"
  local embedded_ver
  embedded_ver="$(workflow_embedded_version "$dest" "$plugin")"

  if [[ "$embedded_ver" == "absent" ]]; then
    echo "absent"
  elif [[ "$embedded_ver" != "$catalog_ver" ]]; then
    echo "drifted"
  elif cmp -s "$src" "$dest"; then
    echo "present"
  else
    echo "mismatch"
  fi
}

# Return the catalog version for a plugin ("claudio-dr" or "cody-dr").
plugin_catalog_version() {
  local plugin="$1"
  if [[ "$plugin" == "claudio-dr" ]]; then
    claudio_version
  else
    cody_version
  fi
}

# ---------------------------------------------------------------------------
# Vendored core/ files
# ---------------------------------------------------------------------------

# A catalog file copied into a consumer at the catalog's own path is a copy
# nothing installs, verifies, or removes (dr-agents#304). Every consumer that
# carried one drifted; the reusable publishers read the catalog checkout, so no
# copy is ever executed. Report each one by name and state and fail: an
# identical copy is the same defect as a diverged one, because nothing keeps it
# identical. Only the repository-root core/ is inspected — a nested core/ is an
# ordinary source directory — and only files with a catalog counterpart count,
# so a consumer's own root core/ is left alone. Nothing is deleted: an
# installer that removes files in a repository it does not own is not one
# anybody should trust.
#
# Prints one line per vendored file and returns the count.
report_vendored_core() {
  local repo_root="$1"
  local consumer_core="${repo_root}/core"
  local catalog_core="${REPO_DIR}/core"
  local count=0
  [[ -d "$consumer_core" ]] || return 0
  # The catalog itself is not a consumer of itself.
  [[ "$(cd "$consumer_core" && pwd -P)" == "$(cd "$catalog_core" && pwd -P)" ]] && return 0

  local file rel state
  while IFS= read -r file; do
    rel="${file#"${repo_root}/"}"
    [[ -f "${catalog_core}/${rel#core/}" ]] || continue
    if cmp -s "$file" "${catalog_core}/${rel#core/}"; then
      state="identical to catalog"
    else
      state="diverged from catalog"
    fi
    echo "  vendored catalog file: ${rel} (${state})" >&2
    count=$((count + 1))
  done < <(find "$consumer_core" -type f | LC_ALL=C sort)

  if [[ "$count" -gt 0 ]]; then
    echo "  ${count} catalog file(s) are vendored into this repository. Nothing installs," >&2
    echo "  verifies, or runs them: publishers read the catalog checkout. Delete the" >&2
    echo "  copies; this installer will not remove them for you." >&2
    echo "" >&2
  fi
  return "$count"
}

# ---------------------------------------------------------------------------
# (no args) — check workflow presence and drift in CWD .github/workflows/
# ---------------------------------------------------------------------------

mode_check_workflows() {
  local repo_root
  repo_root="$(pwd)"
  local wf_dir="${repo_root}/.github/workflows"

  echo "Workflow status in ${wf_dir}:"
  echo ""

  local mismatches=0
  for entry in "${managed_workflows[@]}"; do
    local wf_name="${entry%%:*}"
    local plugin="${entry##*:}"
    local catalog_ver
    catalog_ver="$(plugin_catalog_version "$plugin")"
    local src="${REPO_DIR}/plugins/${plugin}/workflows/${wf_name}"
    local dest="${wf_dir}/${wf_name}"
    local embedded_ver
    embedded_ver="$(workflow_embedded_version "$dest" "$plugin")"

    local status
    case "$(workflow_stub_state "$dest" "$src" "$plugin" "$catalog_ver")" in
      absent)   status="absent" ;;
      present)  status="present" ;;
      mismatch)
        status="MISMATCH  (v${catalog_ver} on both sides, content differs)"
        mismatches=$((mismatches + 1))
        ;;
      *)        status="drifted  (installed: v${embedded_ver}, catalog: v${catalog_ver})" ;;
    esac
    printf "  %-50s %s\n" "$wf_name" "$status"
  done
  echo ""

  local vendored=0
  report_vendored_core "$repo_root" || vendored=$?

  if [[ "${mismatches}" -gt 0 ]]; then
    report_mismatch_diagnosis "${mismatches}"
    return 1
  fi
  [[ "${vendored}" -eq 0 ]] || return 1
}

# Explain a MISMATCH once, naming both causes and the escape hatch.
#
# Drift is routine and exits zero. A mismatch is a defect somewhere upstream, so
# it exits non-zero: a consumer's CI can gate on this command, and the operator
# who runs it by hand gets told rather than reassured.
report_mismatch_diagnosis() {
  local count="$1"
  echo "  ${count} stub(s) carry the current version marker over different content." >&2
  echo "  That means the catalog template changed without a version bump, or the" >&2
  echo "  stub was edited in place. Bump the plugin version in the catalog and" >&2
  echo "  reinstall, or re-run with --force to overwrite the stub as it stands." >&2
  echo "" >&2
}

# ---------------------------------------------------------------------------
# --workflows — install managed workflows to CWD .github/workflows/
# ---------------------------------------------------------------------------

mode_install_workflows() {
  local repo_root
  repo_root="$(pwd)"
  local wf_dir="${repo_root}/.github/workflows"

  if [[ "${FORCE:-0}" == "1" ]]; then
    echo "WARNING: --force is set; all managed workflows will be overwritten."
    echo ""
  fi

  echo "Installing managed workflows to ${wf_dir}:"
  echo ""

  local any_mismatch=0
  for entry in "${managed_workflows[@]}"; do
    local wf_name="${entry%%:*}"
    local plugin="${entry##*:}"
    local catalog_ver
    catalog_ver="$(plugin_catalog_version "$plugin")"
    local src="${REPO_DIR}/plugins/${plugin}/workflows/${wf_name}"
    local dest="${wf_dir}/${wf_name}"
    local embedded_ver
    embedded_ver="$(workflow_embedded_version "$dest" "$plugin")"

    case "$(workflow_stub_state "$dest" "$src" "$plugin" "$catalog_ver")" in
      absent)
        mkdir -p "$wf_dir"
        cp "$src" "$dest"
        echo "  installed  ${wf_name}  (v${catalog_ver})"
        ;;
      present)
        if [[ "${FORCE:-0}" == "1" ]]; then
          cp "$src" "$dest"
          echo "  installed  ${wf_name}  (force, v${catalog_ver})"
        else
          echo "  unchanged  ${wf_name}  (v${catalog_ver})"
        fi
        ;;
      mismatch)
        # Report, do not update. Overwriting would restore byte identity and
        # leave the forgotten version bump invisible to the one person in a
        # position to notice it — which is how dr-agents#282 stayed silent in
        # three consumers. --force remains the explicit way to overwrite, and
        # the diagnosis below says so.
        if [[ "${FORCE:-0}" == "1" ]]; then
          cp "$src" "$dest"
          echo "  installed  ${wf_name}  (force, content mismatch at v${catalog_ver})"
        else
          echo "  MISMATCH   ${wf_name}  (v${catalog_ver} on both sides, content differs)"
          any_mismatch=$((any_mismatch + 1))
        fi
        ;;
      *)
        # drifted — update to catalog version
        if [[ "${FORCE:-0}" == "1" ]]; then
          cp "$src" "$dest"
          echo "  installed  ${wf_name}  (force, v${embedded_ver} -> v${catalog_ver})"
        else
          cp "$src" "$dest"
          echo "  updated    ${wf_name}  (v${embedded_ver} -> v${catalog_ver})"
        fi
        ;;
    esac
  done

  echo ""

  # Publication scripts are no longer vendored (dr-agents#260). A publisher is a
  # thin workflow_dispatch stub that calls the central definition, which checks
  # this catalog out at the ref the stub names and runs the scripts from there.
  # Copying them here would reintroduce, on the next install, exactly the six
  # drifting copies the migration removed.
  #
  # A repository migrated before this change still carries the old directory.
  # Report it and leave it untouched: an installer that deletes files in a
  # repository it does not own is not one anybody should trust.
  local stale_helper_dir="${repo_root}/.github/scripts/agent-workflows"
  if [[ -d "$stale_helper_dir" ]]; then
    echo "  note: ${stale_helper_dir} holds vendored publisher helpers from before"
    echo "        the reusable-workflow migration. Nothing reads them now; they are"
    echo "        safe to delete. This installer will not remove them for you."
    echo ""
  fi

  local vendored=0
  report_vendored_core "$repo_root" || vendored=$?

  if [[ "${any_mismatch}" -gt 0 ]]; then
    echo "Workflow install incomplete: ${any_mismatch} stub(s) left untouched." >&2
    report_mismatch_diagnosis "${any_mismatch}"
    return 1
  fi
  [[ "${vendored}" -eq 0 ]] || return 1

  echo "Workflow install complete (dispatch stubs only; publication runs from the catalog)."
}

# Report — never remove — a legacy direct Claudio payload copy.
#
# Before dr-agents#427, `--global` copied plugins/claudio-dr straight into
# ~/.claude/, in parallel with the marketplace registration Claude Code
# actually loads. Hosts installed before that change still carry the copy, and
# every one of its agent and skill names collides with the registered copy, so
# the two drift the moment only one is refreshed.
#
# This reports the copy and stops there. Removal is a separate, explicitly
# confirmed action: an installer that deletes files in a directory it no longer
# owns is not one anybody should trust. For the same reason no payload
# directory is ever named as a whole: ~/.claude/agents/ and ~/.claude/skills/
# also hold the user's own agents and Claude Code's synced-skills store. Only
# entries carrying a name this catalog owns are reported.
report_legacy_claudio_copy() {
  local claude_config="$1"

  # Derived from the plugin tree rather than hand-listed: a directory added to
  # plugins/claudio-dr/ later is a directory an old install also copied, and a
  # fixed list would stop naming it the day that happens.
  local legacy_paths=()
  [[ -f "${claude_config}/.claude-plugin/plugin.json" ]] \
    && legacy_paths+=("${claude_config}/.claude-plugin/plugin.json")
  local entry name child child_name
  for entry in "${REPO_DIR}"/plugins/claudio-dr/*/; do
    [[ -d "$entry" ]] || continue
    name="$(basename "$entry")"
    # workflows/ is installed only by --workflows and was never part of the
    # direct copy.
    [[ "$name" == "workflows" ]] && continue
    # Never name a payload directory itself: the existence of ~/.claude/agents
    # proves nothing about who wrote what is inside it, and ~/.claude/skills/
    # is also Claude Code's own synced-skills store. Only entries whose names
    # come from this catalog are reported, so a user's own agent, command or
    # skill is never handed to the operator as a removal target.
    for child in "$entry"*; do
      [[ -e "$child" ]] || continue
      child_name="$(basename "$child")"
      [[ -e "${claude_config}/${name}/${child_name}" ]] \
        && legacy_paths+=("${claude_config}/${name}/${child_name}")
    done
  done

  [[ "${#legacy_paths[@]}" -gt 0 ]] || return 0

  echo ""
  echo "  note: ${claude_config} still holds a legacy direct Claudio DR copy from"
  echo "        before the marketplace migration (dr-agents#427). Claude Code loads"
  echo "        claudio-dr@dr-agents from plugins/cache/dr-agents/, not these paths,"
  echo "        and the two drift once only one is refreshed. This installer"
  echo "        will not remove them for you; removing them is a separate,"
  echo "        explicitly confirmed step. Paths:"
  local path
  for path in "${legacy_paths[@]}"; do
    echo "          ${path}"
  done
}

# ---------------------------------------------------------------------------
# --global
# ---------------------------------------------------------------------------

mode_global() {
  local claudio_ver
  claudio_ver="$(claudio_version)"

  local cody_ver
  cody_ver="$(cody_version)"

  local claude_config="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"

  local agents_dest="${HOME}/.local/bin/agents"

  local conflicts=0

  if [[ "${FORCE:-0}" == "1" ]]; then
    echo "WARNING: --force is set; all conflicting files will be overwritten without error."
    echo ""
  fi

  echo "Installing claudio-dr v${claudio_ver}"
  echo "  marketplace: dr-agents (${REPO_DIR})"
  echo "  plugin     : claudio-dr@dr-agents"
  echo ""
  if ! command -v claude >/dev/null 2>&1; then
    echo "claude CLI is required to install claudio-dr through the dr-agents marketplace" >&2
    exit 1
  fi
  claude plugin marketplace add "${REPO_DIR}"
  # Claude Code spells this `install` where Codex spells it `add`. The
  # divergence belongs to the two CLIs, not to this catalog.
  claude plugin install claudio-dr@dr-agents

  report_legacy_claudio_copy "${claude_config}"

  echo ""
  echo "Installing cody-dr v${cody_ver}"
  echo "  marketplace: dr-agents (${REPO_DIR})"
  echo "  plugin     : cody-dr@dr-agents"
  echo ""
  if ! command -v codex >/dev/null 2>&1; then
    echo "codex CLI is required to install cody-dr through the dr-agents marketplace" >&2
    exit 1
  fi
  codex plugin marketplace add "${REPO_DIR}"
  codex plugin add cody-dr@dr-agents

  echo ""
  echo "Installing agents CLI"
  echo "  to  : ${agents_dest}"
  echo ""
  mkdir -p "$(dirname "${agents_dest}")"
  write_agents_wrapper "${HOME}/.local/share/dr-agents/catalog-path" "${agents_dest}"
  echo "  installed  agents  (catalog: ${REPO_DIR})"

  write_pointer_file "${REPO_DIR}"

  echo ""
  if [[ "${conflicts}" -gt 0 ]]; then
    echo "Completed with ${conflicts} conflict(s). Resolve the conflicts above and re-run." >&2
    exit 1
  fi
  echo "Global install complete."
  echo "To update in the future, run: agents update --global"
}

# ---------------------------------------------------------------------------
# --repo [--profile <name>]
# ---------------------------------------------------------------------------

mode_repo() {
  local profile_name="$1"
  local repo_root
  repo_root="$(pwd)"
  local dest_dir="${repo_root}/.claude"

  local claudio_src="${REPO_DIR}/plugins/claudio-dr"
  local claudio_ver
  claudio_ver="$(claudio_version)"

  local conflicts=0

  if [[ "${FORCE:-0}" == "1" ]]; then
    echo "WARNING: --force is set; all conflicting files will be overwritten without error."
    echo ""
  fi

  echo "Installing claudio-dr v${claudio_ver} (repo-local)"
  echo "  from: ${claudio_src}"
  echo "  to  : ${dest_dir}"
  echo ""
  install_plugin_dir "${claudio_src}" "${dest_dir}" "${claudio_ver}" || conflicts=$((conflicts + 1))

  if [[ -n "${profile_name}" ]]; then
    local profile_file="${REPO_DIR}/profiles/${profile_name}.md"
    if [[ ! -f "${profile_file}" ]]; then
      echo "Profile '${profile_name}' not found at ${profile_file}" >&2
      exit 1
    fi
    local profile_dest="${dest_dir}/profiles/${profile_name}.md"
    echo ""
    echo "Applying profile '${profile_name}'"
    echo "  from: ${profile_file}"
    echo "  to  : ${profile_dest}"
    install_file "${profile_file}" "${profile_dest}" "profiles/${profile_name}.md" "${claudio_ver}" \
      || conflicts=$((conflicts + 1))
  fi

  write_pointer_file "${REPO_DIR}"

  echo ""
  if [[ "${conflicts}" -gt 0 ]]; then
    echo "Completed with ${conflicts} conflict(s). Resolve the conflicts above and re-run." >&2
    exit 1
  fi
  echo "Repo install complete: ${dest_dir}"
}

# ---------------------------------------------------------------------------
# --status
# ---------------------------------------------------------------------------

mode_status() {
  local repo_root
  repo_root="$(pwd)"

  local catalog_claudio_ver
  catalog_claudio_ver="$(claudio_version)"
  local catalog_cody_ver
  catalog_cody_ver="$(cody_version)"

  local codex_config="${CODEX_CONFIG_DIR:-${HOME}/.codex}"
  local claude_config="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  local global_claudio_cache="${claude_config}/plugins/cache/dr-agents/claudio-dr/${catalog_claudio_ver}"
  local global_claudio_manifest="${global_claudio_cache}/.claude-plugin/plugin.json"
  local global_cody_manifest="${codex_config}/plugins/cache/dr-agents/cody-dr/${catalog_cody_ver}/.codex-plugin/plugin.json"
  local local_claudio_manifest="${repo_root}/.claude/.claude-plugin/plugin.json"

  echo "dr-agents install status"
  echo ""
  echo "Catalog: ${REPO_DIR}"
  echo "  claudio-dr  v${catalog_claudio_ver}"
  echo "  cody-dr     v${catalog_cody_ver}"
  echo ""
  local agents_dest="${HOME}/.local/bin/agents"
  local agents_status
  if [[ -f "${agents_dest}" ]]; then
    agents_status="installed"
  else
    agents_status="not installed"
  fi

  echo "Global:"
  echo "  claudio-dr  $(installed_version "${global_claudio_manifest}")  (${global_claudio_cache}/)"
  echo "  cody-dr     $(installed_version "${global_cody_manifest}")  (${codex_config}/plugins/cache/dr-agents/cody-dr/${catalog_cody_ver}/)"
  echo "  agents      ${agents_status}  (${agents_dest})"
  echo ""
  echo "Repo (${repo_root}):"
  echo "  claudio-dr  $(installed_version "${local_claudio_manifest}")  (.claude/)"

  report_legacy_claudio_copy "${claude_config}"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

MODE=""
PROFILE_NAME=""
DOWNLOAD_VERSION=""
FORCE=0

# --global, --repo, --download, --status and --workflows are the five
# alternative invocations in usage(); no two may be combined. Selecting the
# mode through this helper rejects a conflicting pair during parsing, so the
# rejection is order-independent and happens before any file is written.
# Repeating the same flag is idempotent, not a conflict. `check_workflows` is
# the no-flag default rather than a flag, so it is not part of this set.
set_mode() {
  local requested="$1"
  if [[ -n "${MODE}" && "${MODE}" != "${requested}" ]]; then
    echo "--${MODE} and --${requested} are mutually exclusive" >&2
    exit 1
  fi
  MODE="${requested}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --global)
      set_mode "global"
      shift
      ;;
    --repo)
      set_mode "repo"
      shift
      ;;
    --download)
      set_mode "download"
      shift
      ;;
    --version)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "--version requires a version argument (e.g. --version v1.2.3)" >&2
        exit 1
      fi
      DOWNLOAD_VERSION="$2"
      shift 2
      ;;
    --profile)
      if [[ $# -lt 2 || -z "$2" ]]; then
        echo "--profile requires a name argument" >&2
        exit 1
      fi
      PROFILE_NAME="$2"
      shift 2
      ;;
    --status)
      set_mode "status"
      shift
      ;;
    --workflows)
      set_mode "workflows"
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      ;;
  esac
done

# No args: check workflow presence/drift (new default behavior)
if [[ -z "${MODE}" ]]; then
  MODE="check_workflows"
fi

if [[ "${PROFILE_NAME}" != "" && "${MODE}" != "repo" ]]; then
  echo "--profile is only valid with --repo" >&2
  exit 1
fi

if [[ -n "${DOWNLOAD_VERSION}" && "${MODE}" != "download" ]]; then
  echo "--version is only valid with --download" >&2
  exit 1
fi

if [[ "${FORCE}" == "1" && "${MODE}" == "status" ]]; then
  echo "--force is not valid with --status" >&2
  exit 1
fi

if [[ "${FORCE}" == "1" && "${MODE}" == "check_workflows" ]]; then
  echo "--force is not valid without --workflows" >&2
  exit 1
fi

export FORCE

case "${MODE}" in
  check_workflows) mode_check_workflows ;;
  global)          mode_global ;;
  repo)            mode_repo "${PROFILE_NAME}" ;;
  download)        mode_download "${DOWNLOAD_VERSION}" ;;
  status)          mode_status ;;
  workflows)       mode_install_workflows ;;
esac
