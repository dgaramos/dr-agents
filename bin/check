# The public catalog must not embed a consumer project's identifying details.
# Split the sentinel so this check does not match its own source.
readonly forbidden_target_pattern='craft''control|dgaramos/craft''control'
if [[ "${_IN_GIT_REPO}" == "1" ]]; then
  if git grep -n -i -E "$forbidden_target_pattern" -- . >/dev/null; then
    echo "target-project reference detected; consumer profiles belong in their target repository" >&2
    exit 1
  fi
fi

# This catalog may keep only its own profile and the neutral template. A
# consumer profile belongs in the consumer repository, never in this public
# catalog.
readonly allowed_profile_paths=$'.gitkeep\ndr-agents.md\nexample-project.md'
if [[ "${_IN_GIT_REPO}" == "1" ]]; then
  actual_profile_paths="$(git ls-files profiles/ | sed 's#^profiles/##' | sort)"
  if [[ "$actual_profile_paths" != "$allowed_profile_paths" ]]; then
    echo "profiles: consumer project profiles must not be committed to the catalog" >&2
    exit 1
  fi
fi

# Validate that branch commits use one recognized adapter co-author identity.
# In shallow clones (e.g. CI with fetch-depth != 0) git merge-base may fail;
# emit a warning and skip the check rather than producing false positives.
# When running from an extracted tarball (no git repo) this check is skipped.
if [[ "${_IN_GIT_REPO}" == "1" ]]; then
  if merge_base="$(git merge-base HEAD main 2>/dev/null)"; then
    while IFS= read -r commit; do
      trailers="$(git show -s --format=%B "$commit" | git interpret-trailers --parse)"
      agent_trailers="$(printf '%s\n' "$trailers" | grep -Ei '^Co-Authored-By: (cody-dr|claudio-dr|Claude|Codex)([^[:alnum:]]|$)' || true)"
      case "$agent_trailers" in
        'Co-Authored-By: cody-dr[bot] <318732897+cody-dr[bot]@users.noreply.github.com>'|'Co-Authored-By: claudio-dr[bot] <318764128+claudio-dr[bot]@users.noreply.github.com>') ;;
        *) echo "trailer: $commit must contain exactly one canonical adapter co-author" >&2; exit 1 ;;
      esac
    done < <(git rev-list --no-merges "${merge_base}..HEAD")
  else
    echo "warning: cannot resolve merge-base with main; trailer identity check skipped (shallow clone?)" >&2
  fi
fi

AGENT_WORKFLOWS_DIR="$(pwd)" bin/drift

if [[ "${_IN_GIT_REPO}" == "1" ]]; then
  git diff --check
fi
echo "catalog quality check: ok"
