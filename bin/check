# docs/compatibility.md so contributors do not file false parity bug reports.
# This is a warning only — the note is good practice, not a hard invariant.
if ! grep -qF 'Helper invocation style' docs/compatibility.md; then
  echo "warning: docs/compatibility.md does not document helper invocation style divergence as intentional" >&2
fi

