  "plugins/cody-dr/skills/review-pr/references/review-contract.md"
)

for path in "${forbidden_paths[@]}"; do
  if test -f "$path"; then
    echo "drift: $path is an adapter-local contract copy; use the generated plugin core bundle" >&2
    exit 1
  fi
done

