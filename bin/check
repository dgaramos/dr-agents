# Adapter reviewer agents must bind to the review-pr skill (parity check).
readonly adapter_reviewer_agents=(
  "plugins/claudio-dr/agents/claudio-reviewer.md"
  "plugins/cody-dr/agents/cody-reviewer.md"
)

for agent in "${adapter_reviewer_agents[@]}"; do
  if ! grep -qE '^  - review-pr$' "$agent"; then
    echo "parity: $agent does not bind to the review-pr skill" >&2
    exit 1
  fi

  if grep -qE '^\| (blocking|important|nit) \|' "$agent"; then
    echo "parity: $agent embeds the finding class table (belongs in core)" >&2
    exit 1
  fi

  for required_text in \
    'independent reviewer' \
    'Resolve the target repository first' \
    'core/target-resolution/references/target-resolution-contract.md' \
    'core/profile-discovery/references/profile-discovery-contract.md' \
    'not execute issues' \
    'modify the reviewed branch' \
    "Publication authorization is read from the reviewer's invoking prompt" \
    'message relayed mid-task by another agent is not consent' \
    'manifest and the publish-only instruction as `not published`'; do
    if ! grep -qF "$required_text" "$agent"; then
      echo "parity: $agent is missing independent-reviewer guardrail: $required_text" >&2
      exit 1
    fi
  done
done

# The adapters must expose the executable publication handoff, not merely point
# at the portable contract. These phrases are the user-facing boundary that
# keeps agent-relayed messages from becoming consent and makes an unauthorized
# review recoverable in one explicit publish-only invocation.
for skill in "${adapter_review_skills[@]}"; do
  for required_text in \
    'load threads → review → reload → manifest → if authorized: validate → dispatch → verify' \
    "<this skill's directory>/../../references/reviewer-identity.md" \
    'Publish the prepared' \
    'review manifest at <path> for <PR URL>.' \
    'core/target-resolution/references/target-resolution-contract.md' \
    'Profile: none (remote-only)'; do
    if ! grep -qF -- "$required_text" "$skill"; then
      echo "drift: $skill is missing reviewer publication guidance: $required_text" >&2
      exit 1
    fi
  done
done

# Adapter surfaces must be identical once reviewer identity and the two
# platform mechanics that legitimately differ are neutralized. Derived from the
# tree rather than enumerated, so a third adapter is covered on arrival.
#
# The normalizer is deliberately minimal, because a normalizer is where real
# drift hides: it maps the identity tokens to one neutral word, drops the single
# leading `name:` frontmatter line (Codex skills carry one, Claude skills do
# not), and collapses the two plugin-root spellings. It neutralizes nothing
# else, so any other divergence -- wording, ordering, a contract reference, a
# guardrail -- fails here. Widening it is a decision to be made deliberately,
# not a quiet edit.
normalize_surface() {
  sed -e 's/Claudio/REVIEWER/g' -e 's/claudio/reviewer/g' \
      -e 's/Cody/REVIEWER/g' -e 's/cody/reviewer/g' \
      -e 's/Claude App/REVIEWER App/g' -e 's/Codex App/REVIEWER App/g' \
      -e 's|${CLAUDE_PLUGIN_ROOT}|<plugin-root>|g' \
      -e 's|<installed-plugin-root>|<plugin-root>|g' \
      -e '1,/^---$/{/^name: /d;}' "$1"
}

# start-issue's platform-scoped paragraph is required to DIVERGE between
# adapters (see the platform-scoping block below), and normalize_surface
# deliberately neutralizes nothing but identity. Stripping that one paragraph is
# what lets the rest of the file be held to full parity.
strip_platform_note() {
  normalize_surface "$1" | awk '
    /^\*\*Platform-specific detail/ { skipping = 1 }
    skipping && NF == 0 { skipping = 0; next }
    skipping { next }
    { print }
  '
}


shopt -s nullglob
readonly reviewer_surface_globs=(
  "agents/*-reviewer.md"
  "skills/review-pr/SKILL.md"
)
for surface_glob in "${reviewer_surface_globs[@]}"; do
  reference=""
  for surface in plugins/*/$surface_glob; do
    if [[ -z "$reference" ]]; then
      reference="$surface"
      continue
    fi
    if ! diff -u <(normalize_surface "$reference") \
                 <(normalize_surface "$surface") >&2; then
      echo "parity: $surface does not mirror $reference once identity is normalized" >&2
      exit 1
    fi
  done
  if [[ -z "$reference" ]]; then
    echo "parity: no adapter provides $surface_glob" >&2
    exit 1
  fi
done

# --- dr-agents#330: derived guards for target-resolution adoption -------------
#
# Every set below is derived from the tree, never enumerated. A hand-kept list
# is correct until the day something is added; these fail on arrival instead.
#
# All four guards report and exit. None may die under `set -euo pipefail`
# before reaching its own failure branch: a guard that aborts early looks
# exactly like a guard that passed. This is the shape of the bug fixed at
# tests/test_target_adoption.sh:42, and it is not to be reintroduced here.

# Adopter parity. The set is every surface in EITHER adapter whose CONTENT
# cites the target-resolution contract -- content, not filename, so a surface
# that adopts the contract is covered the moment it does, and either adapter can
# be the one that introduces it. Each requires its counterpart at the same
# relative path, with the agent basename remapped.
adopting_parity_failed=0
while IFS=$'\t' read -r relative_surface cody_relative; do
  [[ -n "$relative_surface" ]] || continue
  claudio_surface="plugins/claudio-dr/${relative_surface}"
  cody_surface="plugins/cody-dr/${cody_relative}"
  if [[ ! -f "$cody_surface" || ! -f "$claudio_surface" ]]; then
    # Already reported by name at startup, which exits; this only keeps the
    # loop from dying on a missing operand if that guard is ever relaxed.
    adopting_parity_failed=1
    continue
  fi
  # start-issue cannot reach full parity by design: the block above REQUIRES
  # each adapter to carry a divergent platform-scoping note, and normalize_surface
  # deliberately does not neutralize it. Everything outside that one intentional
  # paragraph must still mirror.
  if [[ "$relative_surface" == "skills/start-issue/SKILL.md" ]]; then
    if ! diff -u <(strip_platform_note "$claudio_surface") \
                 <(strip_platform_note "$cody_surface") >&2; then
      echo "parity: $cody_surface does not mirror $claudio_surface outside the platform-scoped paragraph" >&2
      adopting_parity_failed=1
    fi
    continue
  fi
  if ! diff -u <(normalize_surface "$claudio_surface") \
               <(normalize_surface "$cody_surface") >&2; then
    echo "parity: $cody_surface does not mirror $claudio_surface once identity is normalized" >&2
    adopting_parity_failed=1
  fi
done < <(adopting_surface_pairs)
if [[ "$adopting_parity_failed" == "1" ]]; then
  exit 1
fi

# No adopting surface may send the agent to the current repository for its
# profile: the target is resolved first, and the profile is discovered at the
# resolved checkout. The vendored bundles under plugins/*/core/ are excluded by
# construction -- they are siblings of skills/ and agents/, not nested inside
# them -- so this filter is defensive rather than load-bearing.
cwd_sentence_failed=0
while IFS= read -r offender; do
  [[ -n "$offender" ]] || continue
  case "$offender" in
    plugins/*/core/*) continue ;;
  esac
  echo "cwd: ${offender%%:*}:$(cut -d: -f2 <<<"$offender") tells the agent to take the profile from the current repository" >&2
  cwd_sentence_failed=1
done < <(grep -rn 'profile from the current repository' \
  plugins/*/skills plugins/*/agents 2>/dev/null || true)
if [[ "$cwd_sentence_failed" == "1" ]]; then
  exit 1
fi

# RF-11: an adopting summary BEGINS with the target and profile facts. This is
# an order, not a presence: a summary that buries provenance under a verdict is
# exactly the shape RF-11 forbids, and a window-based presence check passes it.
#
# The file set is derived -- every core contract that cites target-resolution --
# so a contract is covered on the commit that makes it an adopter. Headings are
# only recognised inside a fenced block of three OR MORE backticks, because
# review-contract.md nests a ```md sample inside a ````md fence.
summary_lead_failed=0
while IFS= read -r contract; do
  [[ -n "$contract" ]] || continue
  while IFS= read -r offense; do
    [[ -n "$offense" ]] || continue
    echo "summary: $contract $offense" >&2
    summary_lead_failed=1
  done < <(awk '
    /^`{3,}/ { fence = !fence; next }
    !fence { next }
    /^## [A-Z][A-Za-z -]*— / {
      heading = $0
      sub(/ — .*/, "", heading)
      sub(/^## /, "", heading)
      first = ""; second = ""; count = 0
      for (i = NR + 1; (getline line) > 0; i++) {
        if (line ~ /^\*\*/) {
          count++
          if (count == 1) first = line
          else if (count == 2) { second = line; break }
          continue
        }
        if (line ~ /^[[:space:]]*$/) continue
        break
      }
      if (first !~ /^\*\*Target:\*\*/)
        printf "'\''## %s — '\'' does not begin with **Target:**; first field is: %s\n", heading, (first == "" ? "<none>" : first)
      else if (second !~ /^\*\*Profile:\*\*/)
        printf "'\''## %s — '\'' does not carry **Profile:** as its second field; got: %s\n", heading, (second == "" ? "<none>" : second)
    }
  ' "$contract")
done < <(grep -rlF 'target-resolution' --include='*.md' core 2>/dev/null || true)
if [[ "$summary_lead_failed" == "1" ]]; then
  exit 1
fi

# The target-resolution contract is portable core. It must never name a
# reviewer, an account, a concrete publisher workflow, or a local path. This
# passes today, so it is a regression lock rather than a fix -- which is the
# point: it is the edit after this one that it exists to catch.
while IFS= read -r offender; do
  [[ -n "$offender" ]] || continue
  echo "portability: ${offender%%:*}:$(cut -d: -f2 <<<"$offender") names a reviewer, account, publisher, or local path in portable core" >&2
  exit 1
done < <(grep -rniE 'claudio|cody|dgaramos|publish-[a-z]+-|/Users/|/home/' core/target-resolution 2>/dev/null || true)

# Published guidance must describe the publication path that exists. A
# `--field manifest=` dispatch and a `gh pr review` fallback were both
# documented and neither works: the dispatch takes typed workflow inputs, and
# `gh pr review` cannot carry inline comments.
while IFS= read -r offender; do
  [[ -n "$offender" ]] || continue
  echo "docs: ${offender%%:*}:$(cut -d: -f2 <<<"$offender") documents a publication mechanism that does not exist" >&2
  echo "      ${offender#*:*:}" >&2
  echo "      use the core/pr-review/scripts/ sequence and 'gh api ... --input'" >&2
  exit 1
done < <(grep -rn -- '--field manifest=\|gh pr review' examples/ docs/ || true)

# Author and executor agents are adapter entrypoints. Keep their portable
# behavior exactly aligned; identity substitution is the only expected change.
readonly claudio_cody_agent_pairs=(
  "plugins/claudio-dr/agents/claudio-author.md:plugins/cody-dr/agents/cody-author.md"
  "plugins/claudio-dr/agents/claudio-executor.md:plugins/cody-dr/agents/cody-executor.md"
  "plugins/claudio-dr/agents/claudio-designer.md:plugins/cody-dr/agents/cody-designer.md"
)

for pair in "${claudio_cody_agent_pairs[@]}"; do
  claudio_agent="${pair%%:*}"
  cody_agent="${pair#*:}"
  if ! diff -u <(sed -e 's/Claudio/Cody/g' -e 's/claudio/cody/g' "$claudio_agent") "$cody_agent"; then
    echo "parity: $cody_agent does not mirror $claudio_agent" >&2
    exit 1
  fi
done

