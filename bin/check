  awk '
    BEGIN { valid = 0 }
    NR == 1 { if ($0 != "---") exit 1; next }
    NR > 1 && NR <= 20 {
      if ($0 == "---") {
        valid = has_description
        exit
      }

      if ($0 ~ /^name: /) {
        if ($0 !~ /^name: [a-z0-9-]+$/) exit 1
        next
      }

      if ($0 ~ /^description: .+/) {
        has_description = 1
        next
      }

      if ($0 ~ /^[A-Za-z][A-Za-z0-9_-]*:/) next
      exit 1
    }
    { exit 1 }
    END { if (!valid) exit 1 }
  ' "$skill"
done < <(if [[ "${_IN_GIT_REPO}" == "1" ]]; then git ls-files '*SKILL.md'; else find . -name 'SKILL.md' -not -path '*/.git/*'; fi)

