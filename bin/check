# Agent reviews inform humans; they do not block a PR through REQUEST_CHANGES.
if grep -qF 'REQUEST_CHANGES' .github/workflows/publish-*-review.yml; then
  echo "policy: agent review publishers must not offer REQUEST_CHANGES" >&2
  exit 1
fi

# Claudio DR reviews must always use COMMENT — never APPROVE, never REQUEST_CHANGES.
# The publisher options list must contain COMMENT only.
if ! grep -qF 'options: [COMMENT]' .github/workflows/publish-claudio-review.yml; then
  echo "policy: publish-claudio-review.yml must offer only COMMENT as an event option" >&2
  exit 1
fi
if grep -qF 'APPROVE' .github/workflows/publish-claudio-review.yml; then
  echo "policy: publish-claudio-review.yml must not offer APPROVE" >&2
  exit 1
fi

# The Claudio DR review adapter skill must explicitly state the COMMENT-only
# and inline-findings constraints so the model cannot miss them.
readonly claudio_review_skill="plugins/claudio-dr/skills/review-pr/SKILL.md"
if ! grep -qF 'always `COMMENT`' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not state the COMMENT-only publication rule" >&2
  exit 1
fi
if ! grep -qF 'never submits `APPROVE`' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not explicitly forbid APPROVE" >&2
  exit 1
fi
if ! grep -qF 'never submits `REQUEST_CHANGES`' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not explicitly forbid REQUEST_CHANGES" >&2
  exit 1
fi
if ! grep -qF 'Inline findings only' "$claudio_review_skill"; then
  echo "drift: $claudio_review_skill does not state the inline-findings-only constraint" >&2
  exit 1
fi

# The Cody DR review adapter skill must explicitly state the COMMENT-only
# and inline-findings constraints so the model cannot miss them.
readonly cody_review_skill="plugins/cody-dr/skills/review-pr/SKILL.md"
if ! grep -qF 'always `COMMENT`' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not state the COMMENT-only publication rule" >&2
  exit 1
fi
if ! grep -qF 'never submits `APPROVE`' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not explicitly forbid APPROVE" >&2
  exit 1
fi
if ! grep -qF 'never submits `REQUEST_CHANGES`' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not explicitly forbid REQUEST_CHANGES" >&2
  exit 1
fi
if ! grep -qF 'Inline findings only' "$cody_review_skill"; then
  echo "drift: $cody_review_skill does not state the inline-findings-only constraint" >&2
  exit 1
fi

# Adapter drift check: adapter review-pr SKILL.md files must reference the
# core review contract and must not embed the category table or confidence
# threshold directly (those live only in core/pr-review/references/review-contract.md).
readonly adapter_review_skills=(
  "plugins/claudio-dr/skills/review-pr/SKILL.md"
  "plugins/cody-dr/skills/review-pr/SKILL.md"
)

for skill in "${adapter_review_skills[@]}"; do
  if ! grep -qF 'core/pr-review/references/review-contract.md' "$skill"; then
    echo "drift: $skill does not reference core/pr-review/references/review-contract.md" >&2
    exit 1
  fi

  if grep -qE '^\| (blocking|important|nit) \|' "$skill"; then
    echo "drift: $skill embeds the finding class table (belongs in core)" >&2
    exit 1
  fi

  if grep -qE 'confidence `?>= 80' "$skill"; then
    echo "drift: $skill embeds the confidence threshold (belongs in core)" >&2
    exit 1
  fi

  if ! grep -qF 'references/reviewer-identity.md' "$skill"; then
    echo "drift: $skill does not reference its adapter reviewer identity" >&2
    exit 1
  fi

  if ! grep -qF 'core/pr-review/references/knowledge-sources-contract.md' "$skill"; then
    echo "drift: $skill does not reference the portable knowledge-sources contract" >&2
    exit 1
  fi
done

# Every project-aware adapter skill must instruct the model to discover the target
# profile autonomously. Without this instruction the model requires an explicit
# profile argument and behaves asymmetrically across callers.
readonly profile_discovery_ref="core/profile-discovery/references/profile-discovery-contract.md"
for prefix in "${public_adapter_prefixes[@]}"; do
  while IFS= read -r skill; do
    if ! grep -qF "$profile_discovery_ref" "$skill"; then
      echo "drift: $skill does not reference $profile_discovery_ref" >&2
      exit 1
    fi
  done < <(find "$prefix/skills" -mindepth 2 -maxdepth 2 -name SKILL.md | sort)
done

