# Detect whether we are running inside a git repository.
# Checks that require git (secret detection, pattern search, profile listing,
# trailer validation) are skipped with a warning when running from an extracted
# tarball that has no .git directory.
if git rev-parse --git-dir >/dev/null 2>&1; then
  _IN_GIT_REPO=1
else
  _IN_GIT_REPO=0
  echo "warning: not a git repository; git-dependent checks will be skipped" >&2
fi

for path in "${required_paths[@]}"; do
  if ! test -f "$path"; then
    echo "required path missing: $path" >&2
    exit 1
  fi
done

# A dangling symlink makes this repository unusable as a GitHub Actions action
# repository: the runner stages the whole repo before resolving the action and
# aborts on the first unresolvable link. Measured in dr-agents#260 T01.
dangling=0
while IFS= read -r link; do
  [[ -n "$link" ]] || continue
  if [[ ! -e "$link" ]]; then
    echo "dangling symlink: $link -> $(readlink "$link")" >&2
    dangling=1
  fi
done < <(find . -path ./.git -prune -o -type l -print)
if [[ "$dangling" == "1" ]]; then
  echo "dangling symlinks break GitHub Actions action staging" >&2
  exit 1
fi

# Each managed workflow template must carry a version comment so the installer
# can detect drift without a full file diff.
claudio_wf_ver="$(grep '"version"' plugins/claudio-dr/.claude-plugin/plugin.json | head -1 \
  | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
cody_wf_ver="$(grep '"version"' plugins/cody-dr/.codex-plugin/plugin.json | head -1 \
  | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
for wf in plugins/claudio-dr/workflows/publish-claudio-*.yml; do
  if ! grep -qF "# claudio-dr: v${claudio_wf_ver}" "$wf"; then
    echo "drift: $wf is missing version comment '# claudio-dr: v${claudio_wf_ver}'" >&2
    exit 1
  fi
done
for wf in plugins/cody-dr/workflows/publish-cody-*.yml; do
  if ! grep -qF "# cody-dr: v${cody_wf_ver}" "$wf"; then
    echo "drift: $wf is missing version comment '# cody-dr: v${cody_wf_ver}'" >&2
    exit 1
  fi
done

# The hand-maintained .github/workflows/ copy in this catalog is a sixth variant
# of the same publishers. It drifted from the template in both directions until
# dr-agents#260, because only the templates were ever checked.
#
# Since T05 both sides are thin dispatch stubs, so the two divergences this
# guard used to normalize away are gone: a stub names no publication script and
# declares no METADATA_HELPER. Exactly one divergence remains, and it is
# deliberate — the catalog dogfoods the central definition at @main so that its
# own publishers exercise a change before any consumer sees it, while the
# template that consumers install pins the protected release tag.
#
# Normalize that one ref, and assert each side names the ref it is supposed to
# name. A blanket normalization would let the two refs be swapped silently;
# these assertions make the swap a failure, so this is strictly tighter than the
# rule it replaces. Every other byte must still match exactly.
readonly catalog_ref="main"
readonly release_ref="workflows-v1"
readonly reusable_prefix="dgaramos/dr-agents/.github/workflows/reusable-publish-"

normalize_publisher() {
  # Two occurrences of the same ref are normalized: the one in `uses:` and the
  # catalog_ref the stub passes. They must be identical to each other, which
  # assert_reusable_ref checks before this diff runs, so normalizing both here
  # cannot hide a mismatch.
  sed -e "s#\(${reusable_prefix}[a-z-]*\.yml\)@[A-Za-z0-9._/-]*#\1@REF#" \
      -e 's#^\( *catalog_ref: \)[A-Za-z0-9._/-]*$#\1REF#' \
      -e '/^# \(claudio\|cody\)-dr: v/d' "$1"
}

# A stub must call the central definition, and it must call it at the ref that
# side of the migration is pinned to.
assert_reusable_ref() {
  local file="$1" expected_ref="$2" role="$3" line
  line="$(grep -n "^ *uses: ${reusable_prefix}" "$file" || true)"
  if [[ -z "$line" ]]; then
    echo "drift: $file does not call the central publisher definition" >&2
    echo "  expected a 'uses: ${reusable_prefix}<mode>.yml@${expected_ref}' job" >&2
    exit 1
  fi
  if [[ "$(grep -c "^ *uses: ${reusable_prefix}" "$file")" != "1" ]]; then
    echo "drift: $file calls the central publisher definition more than once" >&2
    exit 1
  fi
  if ! grep -q "^ *uses: ${reusable_prefix}[a-z-]*\.yml@${expected_ref}\$" "$file"; then
    echo "drift: $file must pin the central definition at @${expected_ref} (${role})" >&2
    echo "  found: ${line#*:}" >&2
    exit 1
  fi
  # The stub must pass the very ref it calls. A reusable workflow cannot derive
  # its own ref (measured in docs/spike-reusable-workflow-resolution.md), so
  # this static agreement is what keeps the workflow and the catalog scripts on
  # one commit. A stub calling @main while passing catalog_ref: workflows-v1 is
  # precisely the skew that broke run 34505697770.
  local mode passed_ref
  mode="$(sed -n "s#^ *uses: ${reusable_prefix}\\([a-z-]*\\)\\.yml@.*#\\1#p" "$file")"
  case " pr-metadata pr reply resolve review " in
    *" $mode "*)
      passed_ref="$(sed -n 's#^ *catalog_ref: *\(.*\)$#\1#p' "$file")"
      if [[ -z "$passed_ref" ]]; then
        echo "drift: $file calls ${mode} but passes no catalog_ref" >&2
        exit 1
      fi
      if [[ "$passed_ref" != "$expected_ref" ]]; then
        echo "drift: $file passes catalog_ref: ${passed_ref}; must equal the uses: ref @${expected_ref}" >&2
        exit 1
      fi
      ;;
  esac
  # AC-03: the App key crosses the reusable-workflow boundary only by name.
  if grep -q "secrets: *inherit" "$file"; then
    echo "drift: $file uses 'secrets: inherit'; declare app_private_key explicitly" >&2
    exit 1
  fi
}

# AC-10, second half: a stub carries no publication logic.
#
# The ref assertions above prove a stub calls the right definition. They do not
# prove it calls *only* that. A stub that grew a token step or an inline script
# would keep passing them while quietly becoming a seventh variant of the very
# copies dr-agents#260 exists to collapse — and the drift diff would not catch
# it either, because it compares the two stubs to each other, so logic added to
# both sides is invisible to it. These assertions are what make "thin" mean
# something a check can enforce rather than a habit contributors maintain.
assert_stub_is_thin() {
  local file="$1" role="$2"
  # Keyed on the line start, so a word inside an input description is not a
  # false positive.
  local forbidden=(
    '^[[:space:]]*(-[[:space:]]+)?run:|inline script'
    '^[[:space:]]*steps:|a step list'
    '^[[:space:]]*runs-on:|a runner'
  )
  # Keyed anywhere on the line: these name an action, which only ever appears
  # after `uses:`. The count assertion below would also reject them, but a
  # message naming what was added is worth more than one naming an arity.
  forbidden+=(
    'create-github-app-token|an App token step'
    'actions/checkout|a checkout'
  )
  local entry pattern label
  for entry in "${forbidden[@]}"; do
    pattern="${entry%%|*}"
    label="${entry##*|}"
    if grep -qE "${pattern}" "$file"; then
      echo "drift: $file (${role}) is a dispatch stub but declares ${label}" >&2
      echo "  publication logic belongs in .github/workflows/reusable-publish-*.yml" >&2
      exit 1
    fi
  done
  # The single call asserted above must be the only `uses:` in the file.
  local uses_total
  uses_total="$(grep -cE "^[[:space:]]*(-[[:space:]]+)?uses:" "$file" || true)"
  if [[ "$uses_total" != "1" ]]; then
    echo "drift: $file (${role}) has ${uses_total} 'uses:' entries; a stub has exactly one" >&2
    exit 1
  fi
}

for wf in .github/workflows/publish-*.yml; do
  wf_name="$(basename "$wf")"
  case "$wf_name" in
    publish-claudio-*) plugin=claudio-dr; agent=claudio-dr; ver="$claudio_wf_ver" ;;
    publish-cody-*)    plugin=cody-dr;    agent=cody-dr;    ver="$cody_wf_ver" ;;
    *) continue ;;
  esac
  if ! grep -qF "# ${agent}: v${ver}" "$wf"; then
    echo "drift: $wf is missing version comment '# ${agent}: v${ver}'" >&2
    exit 1
  fi
  template="plugins/${plugin}/workflows/${wf_name}"
  if [[ ! -f "$template" ]]; then
    echo "drift: $wf has no template at $template" >&2
    exit 1
  fi
  assert_reusable_ref "$wf" "$catalog_ref" "catalog dogfooding copy"
  assert_reusable_ref "$template" "$release_ref" "installed template"
  assert_stub_is_thin "$wf" "catalog dogfooding copy"
  assert_stub_is_thin "$template" "installed template"
  if ! diff -u <(normalize_publisher "$template") <(normalize_publisher "$wf") >/dev/null; then
    echo "drift: $wf diverges from $template beyond the allowed reusable-workflow ref" >&2
    diff -u <(normalize_publisher "$template") <(normalize_publisher "$wf") >&2 || true
    exit 1
  fi
done

# Every central definition announces which release of itself is executing.
#
# A run's step summary already names the catalog ref. That is the ref the
# *caller* asked for, and while a moving tag is the release mechanism, the ref
# alone cannot distinguish the definition before a promotion from the one after
# it: both are called `workflows-v1`. This marker can, and it is what makes a
# promotion verifiable from a consumer's run page without a commit in that
# consumer (AC-01/AC-08).
#
# Bump it whenever a promoted change alters what a publisher does. All six
# definitions must carry the same value; a partial bump would make the marker
# lie, which is worse than not having one.
readonly definition_release="2"
readonly release_marker="publisher definition release: ${definition_release}"
for wf in .github/workflows/reusable-publish-*.yml; do
  if ! grep -qF "$release_marker" "$wf"; then
    echo "drift: $wf does not announce '${release_marker}'" >&2
    echo "  every central definition emits the same release marker to the step summary" >&2
    exit 1
  fi
  if ! grep -qF 'GITHUB_STEP_SUMMARY' "$wf"; then
    echo "drift: $wf never writes to the step summary" >&2
    exit 1
  fi
done

# The installer must not undo the migration.
#
# Until dr-agents#260 T09, `bin/install --workflows` copied every publication
# script into the target repository. Once the publishers became stubs, running
# it in a migrated repository would have restored the vendored copies the
# migration had just deleted — silently, and reported as a successful install.
# The stub assertions above cannot see that, because it happens in a repository
# this check never runs in.
if grep -nE '(cp|rsync|install)[^|]*\.github/scripts' bin/install >/dev/null; then
  echo "bin/install copies publication scripts into the target repository" >&2
  echo "  publishers are dispatch stubs; the scripts run from this catalog" >&2
  grep -nE '(cp|rsync|install)[^|]*\.github/scripts' bin/install >&2
  exit 1
fi

# The public README is the catalog surface. Every advertised capability must
# exist in both adapters, and adapters may not ship an undocumented skill.
readonly public_skill_names=(
  "review-pr"
  "handle-pr-findings"
  "author-issue"
  "design-discovery"
  "design-and-author"
  "clarify-spec"
  "analyze-spec"
  "classify-spec-drift"
  "start-issue"
  "plan-issue"
  "ship-issue"
  "plan-implementation"
  "implement-issue"
  "ship-change"
  "execute-issue"
)
readonly public_adapter_prefixes=("plugins/cody-dr" "plugins/claudio-dr")

for skill_name in "${public_skill_names[@]}"; do
  if ! grep -qF "\`$skill_name\`" README.md; then
    echo "public surface: README.md does not announce $skill_name" >&2
    exit 1
  fi

  for prefix in "${public_adapter_prefixes[@]}"; do
    skill="$prefix/skills/$skill_name/SKILL.md"
    if ! test -f "$skill"; then
      echo "public surface: $skill_name is missing from $prefix" >&2
      exit 1
    fi
  done
done

for prefix in "${public_adapter_prefixes[@]}"; do
  while IFS= read -r skill; do
    skill_name="$(basename "$(dirname "$skill")")"
    case " ${public_skill_names[*]} " in
      *" $skill_name "*) ;;
      *)
        echo "public surface: $skill is not documented in README.md" >&2
        exit 1
        ;;
    esac
  done < <(find "$prefix/skills" -mindepth 2 -maxdepth 2 -name SKILL.md | sort)
done

# Validate the portable areas that users can install, not merely their files.
# A lifecycle example composes the start, implement, and ship contracts.
readonly required_generic_examples=(
  "examples/generic-pr-review.md"
  "examples/generic-findings-handling.md"
  "examples/generic-issue-authoring.md"
  "examples/generic-design-discovery.md"
  "examples/generic-spec-clarification.md"
  "examples/generic-spec-analysis.md"
  "examples/generic-spec-drift.md"
  "examples/generic-issue-lifecycle.md"
)

for example in "${required_generic_examples[@]}"; do
  if ! test -f "$example"; then
    echo "examples: missing required generic example $example" >&2
    exit 1
  fi
done

# Keep manifests parseable and make each marketplace describe its installed
# adapter version. This avoids publishing a catalog whose public installation
# surface differs from its source tree.
jq -e '.name == "cody-dr" and (.version | type == "string") and .skills == "./skills/" and .agents == "./agents/"' \
  plugins/cody-dr/.codex-plugin/plugin.json >/dev/null
jq -e '.name == "claudio-dr" and (.version | type == "string") and .skills == "./skills/" and (has("agents") | not) and (has("interface") | not)' \
  plugins/claudio-dr/.claude-plugin/plugin.json >/dev/null
claudio_version="$(jq -r '.version' plugins/claudio-dr/.claude-plugin/plugin.json)"
cody_version="$(jq -r '.version' plugins/cody-dr/.codex-plugin/plugin.json)"
claudio_marketplace_version="$(jq -r '.plugins[] | select(.name == "claudio-dr") | .version' .claude-plugin/marketplace.json)"
cody_marketplace_version="$(jq -r '.plugins[] | select(.name == "cody-dr") | .version' .codex-plugin/marketplace.json)"
if [[ "$claudio_version" != "$claudio_marketplace_version" ]]; then
  echo "manifest: Claudio marketplace version does not match plugin version" >&2
  exit 1
fi
if [[ "$cody_version" != "$cody_marketplace_version" ]]; then
  echo "manifest: Cody marketplace version does not match plugin version" >&2
  exit 1
fi

# Reviewer identity is adapter-owned, while capability availability belongs to
# profiles. Keep the display/App/actor mapping explicit and symmetric.
readonly cody_identity="plugins/cody-dr/references/reviewer-identity.md"
readonly claudio_identity="plugins/claudio-dr/references/reviewer-identity.md"
grep -qF '| Display name | Cody DR |' "$cody_identity"
grep -qF '| Publisher | Cody DR GitHub App |' "$cody_identity"
grep -qF '| Verified GitHub actor | `cody-dr[bot]` |' "$cody_identity"
